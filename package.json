{
	"name": "octoguide",
	"version": "0.23.4",
	"description": "A friendly bot that helps contributors adhere to best practices for your repository on GitHub. 🗺️",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/octoguide/bot.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg ✨",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"bin": {
		"octoguide": "bin/index.js"
	},
	"files": [
		"lib/"
	],
	"scripts": {
		"build": "tsc",
		"build:release": "ncc build src/action/index.ts -o dist; node postbuild.js",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules markdownlint-sentences-per-line",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "lefthook install",
		"test": "vitest",
		"tsc": "tsc"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@github/markdownlint-github": "^0.8.3",
		"@octokit/plugin-rest-endpoint-methods": "^17.0.0",
		"are-docs-informative": "^0.1.1",
		"conventional-commit-types": "^3.0.0",
		"conventional-commits-parser": "^7.1.2",
		"is-comment-meaningless": "^0.2.0",
		"lodash": "^4.18.1",
		"markdown-it": "^14.1.1",
		"markdownlint": "0.41.1",
		"marked": "^18.0.12",
		"octokit": "^5.0.5",
		"octokit-from-auth": "^0.3.2",
		"parse-github-url": "^1.0.4"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.0",
		"@eslint/js": "10.0.1",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/eslint-plugin-markdown": "2.0.2",
		"@types/lodash": "4.17.25",
		"@types/markdown-it": "14.2.0",
		"@types/node": "26.6.1",
		"@types/parse-github-url": "1.0.3",
		"@vercel/ncc": "0.45.0",
		"@vitest/coverage-v8": "5.0.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.6.1",
		"cspell": "10.3.0",
		"eslint": "10.10.0",
		"eslint-plugin-jsdoc": "64.5.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-n": "18.3.0",
		"eslint-plugin-package-json": "1.8.1",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-regexp": "3.3.0",
		"eslint-plugin-yml": "3.8.1",
		"knip": "6.36.0",
		"lefthook": "2.1.12",
		"markdownlint-cli": "0.49.1",
		"markdownlint-sentences-per-line": "0.1.4",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "1.0.0",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-sh": "0.19.0",
		"release-it": "21.0.2",
		"type-fest": "5.10.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vitest": "5.0.0"
	},
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24.0.0"
	}
}
