---
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import Default from "@astrojs/starlight/components/Footer.astro";
import Credits from "./Credits.astro";

export type Props = StarlightRouteData;
---

<Default {...Astro.props}>
	<slot />
</Default>

<Credits class="footer-credits" />

<a class="netlify-badge" href="https://www.netlify.com" hidden>
	<img
		src="https://www.netlify.com/assets/badges/netlify-badge-color-accent.svg"
		alt="Deploys by Netlify"
	/>
</a>

<script>
	const isDeployedToNetlify =
		document.querySelector("[data-netlify-deploy-id]") !== null ||
		window.location.hostname.endsWith(".netlify.app");

	if (isDeployedToNetlify) {
		document.querySelector(".netlify-badge")?.removeAttribute("hidden");
	}
</script>

<style>
	.footer-credits {
		padding-top: 2rem;
	}

	.netlify-badge {
		display: block;
		margin: 1.5rem auto 0;
		width: fit-content;
	}

	.netlify-badge[hidden] {
		display: none;
	}

	.netlify-badge img {
		display: block;
		height: auto;
		width: 7rem;
	}
</style>
