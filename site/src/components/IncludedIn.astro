---
import type { ConfigName } from "../../../src/types/core.ts";
import { configEmojis } from "../data/configEmojis.ts";
import { getRule } from "../data/rules.ts";

interface Props {
	rule: string;
}

const { rule: ruleName } = Astro.props;
const rule = getRule(ruleName);

function getRuleConfigs(config: ConfigName) {
	const configs: ConfigName[] = [config];
	if (config === "recommended") {
		configs.push("strict");
	}
	return configs;
}

const configs = getRuleConfigs(rule.about.config);
---

<blockquote>
	Included in{" "}
	<a href="/configs">{configs.length === 1 ? "config" : "configs"}</a>:{" "}
	{configs.map((config, i) => (
		<>
			{configEmojis[config]}&nbsp;{config}
			{i < configs.length - 1 ? ", " : ""}
		</>
	))}
</blockquote>
